{
  "rules": {
    ".read": false,
    ".write": false,
    "energyMatchV10_2": {
      "$classCode": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('teacherUid').val() === auth.uid) || data.child('teacherUid').val() === auth.uid)"
        },
        "messages": {
          ".read": "auth != null",
          "$messageId": {
            ".write": "auth != null && root.child('energyMatchV10_2').child($classCode).child('meta').child('teacherUid').val() === auth.uid"
          }
        },
        "students": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('energyMatchV10_2').child($classCode).child('meta').child('teacherUid').val() === auth.uid)",
            ".write": "auth != null && (auth.uid === $uid || root.child('energyMatchV10_2').child($classCode).child('meta').child('teacherUid').val() === auth.uid)"
          }
        }
      }
    }
  }
}