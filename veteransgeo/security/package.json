{
  "name": "veteransgeo-security-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --project demo-veteransgeo --only database,storage 'node --test rules.test.cjs && VETERANSGEO_RULE_MODE=existing node --test rules.test.cjs'",
    "test:browser": "node --test browser.test.cjs",
    "test:core": "node --test core.test.mjs",
    "test:media": "node --test media-contract.test.mjs token.test.mjs media-sql.test.mjs media-browser.test.mjs",
    "mock:media": "node mock-server.mjs",
    "test:rehearsal": "node --test rehearsal.test.mjs",
    "live:prepare": "node prepare-live-test.mjs",
    "live:probe": "node live-test.mjs --probe-only",
    "live:protocol": "node live-test.mjs",
    "live:serve": "node serve-live-test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-tools": "14.22.0",
    "playwright": "1.62.1"
  }
}
