rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function teacher() { return request.auth != null && request.auth.token.teacher == true; }
  function validFile() {
   return request.resource.size > 0 && (
    (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 10*1024*1024) ||
    (request.resource.contentType.matches('video/(mp4|webm)') && request.resource.size <= 100*1024*1024) ||
    (request.resource.contentType == 'application/pdf' && request.resource.size <= 20*1024*1024));
  }
  match /student-media/{school}/{uid}/{work}/file {
   allow read: if teacher() || (request.auth != null && request.auth.uid == uid);
   allow create, update: if request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous' && school.matches('S[1-7]') && validFile();
   allow delete: if teacher();
  }
  match /published-media/{work}/file {
   allow read: if work.matches('p_[a-f0-9]{64}') && resource.metadata.approved == 'true';
   allow create, update: if teacher() && work.matches('p_[a-f0-9]{64}') && validFile() && request.resource.metadata.approved == 'true';
   allow delete: if teacher();
  }
 }
}
