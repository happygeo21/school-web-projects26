rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in get(/databases/$(database)/documents/access/config).data.emails;
    }
    function valid(d) {
      return d.keys().hasAll(['title','body','category','status','date','amount','revision','updatedBy','updatedAt'])
        && d.keys().hasOnly(['title','body','category','status','date','amount','revision','updatedBy','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.body is string && d.body.size() <= 4000
        && d.category in ['호텔','가족 일정','예산','혼인신고','신혼집','촬영','기타']
        && d.status in ['할 일','진행 중','완료']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.amount is number && d.amount >= 0 && d.amount <= 1000000000
        && d.revision is int && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    match /access/config {
      allow get: if member();
      allow list, write: if false;
    }
    match /records/{id} {
      allow read: if member();
      allow create: if member() && valid(request.resource.data) && request.resource.data.revision == 1;
      allow update: if member() && valid(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
