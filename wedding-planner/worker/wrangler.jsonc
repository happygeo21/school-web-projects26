{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-notion-private-sync",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "FIREBASE_PROJECT_ID": "our-wedding-planner-5baf7",
    "NOTION_DATA_SOURCE": "c5124da9-baac-4670-85ff-f355c192d5b7",
    "ALLOWED_ORIGIN": "https://happygeo21.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "SYNC_STATE", "class_name": "WeddingSync" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WeddingSync"] }]
}
